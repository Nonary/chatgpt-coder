{
  "name": "chatgpt-coding-ide",
  "version": "0.7.4",
  "description": "A local-first Electron IDE companion for exchanging Git patches with ChatGPT.",
  "packageManager": "pnpm@11.19.0",
  "main": "src/main/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "pnpm build:renderer && electron .",
    "test": "node --test",
    "check": "node scripts/check.js",
    "build:renderer": "node scripts/build-renderer.js",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build:renderer && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "dev.patchwork.chatgpt-coding",
    "productName": "ChatGPT - Coder",
    "files": [
      "src/**/*",
      "package.json",
      "settings.example.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "category": "Development"
    },
    "win": {
      "target": "nsis"
    }
  }
}
